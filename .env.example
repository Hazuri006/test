# ==============================================================================
# Yurei Project — configuration d'environnement
# Copiez ce fichier vers `.env` à la racine puis remplissez les valeurs.
# Les deux applications (api/web) lisent ce fichier via dotenv en développement.
# ==============================================================================

# ------------------------------------------------------------------------------
# Général
# ------------------------------------------------------------------------------
NODE_ENV=development
# Nom affiché du panel (modifiable sans toucher au code)
APP_NAME="Yurei Project"

# URL publique du frontend (utilisée pour CORS, redirections OAuth et cookies)
WEB_URL=http://localhost:3000
# URL publique de l'API (utilisée par le frontend)
API_URL=http://localhost:4000
# Port d'écoute de l'API
API_PORT=4000

# ------------------------------------------------------------------------------
# Base de données PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://yurei:yurei@localhost:5432/yurei?schema=public

# ------------------------------------------------------------------------------
# Redis (présence, cache, rate limiting, adapter Socket.IO)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Sécurité
# ------------------------------------------------------------------------------
# Secret de session — générez-le avec: openssl rand -hex 32
SESSION_SECRET=change-me-generate-a-64-char-hex-secret
# Clé de chiffrement AES-256 des tokens Discord — openssl rand -hex 32
APP_ENCRYPTION_KEY=change-me-generate-a-64-char-hex-key
# Durée de vie d'une session (jours)
SESSION_TTL_DAYS=7

# ------------------------------------------------------------------------------
# Discord OAuth2 (obligatoire pour la connexion)
# Voir docs/DISCORD_OAUTH.md pour créer l'application Discord.
# ------------------------------------------------------------------------------
DISCORD_CLIENT_ID=1525235719298093167
DISCORD_CLIENT_SECRET=zl5l6gXUMj0H95h7ufiWtQ6vspYwdZWk
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
# Demander l'e-mail à Discord (scope `email`) — false par défaut
DISCORD_REQUEST_EMAIL=false

# ------------------------------------------------------------------------------
# Synchronisation des rôles Discord (FACULTATIF — la connexion fonctionne sans)
# ------------------------------------------------------------------------------
DISCORD_ROLE_SYNC_ENABLED=false
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
# Webhook facultatif pour publier un résumé des nouveaux tickets dans un salon
DISCORD_TICKET_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Uploads / pièces jointes
# ------------------------------------------------------------------------------
# `local` (développement) ou `s3` (production)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
# Config S3 (uniquement si STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=eu-west-3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Présence
# ------------------------------------------------------------------------------
# Passage en "absent" sans activité (ms)
PRESENCE_AWAY_AFTER_MS=300000
# Déconnexion si aucun heartbeat reçu (ms)
PRESENCE_OFFLINE_AFTER_MS=120000

# ------------------------------------------------------------------------------
# Serveur de jeu (adaptateur)
# ------------------------------------------------------------------------------
# `demo` (données fictives de développement) ou `http`
GAME_SERVER_ADAPTER=demo
# Uniquement pour l'adaptateur http : endpoint JSON du serveur de jeu
GAME_SERVER_STATUS_URL=

# ------------------------------------------------------------------------------
# Seed / démonstration
# ------------------------------------------------------------------------------
# Autorise la création des comptes de démonstration (jamais en production)
SEED_DEMO=true

# ------------------------------------------------------------------------------
# Frontend (variables exposées au navigateur — aucun secret ici)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Yurei Project"
