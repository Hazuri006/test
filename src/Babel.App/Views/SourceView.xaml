<UserControl x:Class="Babel.App.Views.SourceView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Babel.App.Controls">

  <StackPanel HorizontalAlignment="Left">

    <TextBlock Style="{StaticResource TitleText}" Text="Source" />
    <TextBlock Style="{StaticResource SecondaryText}"
               MaxWidth="520"
               Text="Babel écoute le son qui sort de ton ordinateur. Choisis le périphérique sur lequel le jeu joue son audio." />

    <Border Style="{StaticResource Rule}" />

    <TextBlock Style="{StaticResource SettingLabel}" Text="Périphérique de sortie" />
    <ComboBox x:Name="DeviceSelector" IsEnabled="False" />

    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,24,0,6" Text="Niveau capté" />
    <controls:VuMeter x:Name="Meter" />

    <TextBlock Style="{StaticResource SecondaryText}"
               Margin="0,10,0,0"
               MaxWidth="520"
               Text="Si rien ne bouge pendant que le son joue, c'est que le mauvais périphérique est sélectionné." />

    <Border Style="{StaticResource Rule}" />

    <TextBlock Style="{StaticResource SecondaryText}"
               MaxWidth="520"
               Text="La capture du son n'est pas encore branchée. Le vumètre reste à zéro." />

  </StackPanel>

</UserControl>
