<UserControl x:Class="Babel.App.Views.ProfilesView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel HorizontalAlignment="Left">

    <TextBlock Style="{StaticResource TitleText}" Text="Profils" />
    <TextBlock Style="{StaticResource SecondaryText}"
               MaxWidth="520"
               Text="Un profil retient les réglages d'un jeu : la zone de texte à lire, la position des sous-titres et le glossaire des noms propres." />

    <Border Style="{StaticResource Rule}" />

    <TextBlock Style="{StaticResource SecondaryText}"
               MaxWidth="520"
               Text="Les profils ne sont pas encore disponibles. Les réglages actuels s'appliquent à tous les jeux." />

  </StackPanel>

</UserControl>
