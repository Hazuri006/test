<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Babel.App</RootNamespace>

    <!-- Desactive volontairement. Le projet temporaire genere par le compilateur
         de markup WPF ne reprend pas les usings implicites : un fichier qui s'y
         fie compile dans la passe normale et echoue dans la passe XAML. Usings
         explicites partout, et les deux passes voient la meme chose. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Babel</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- x64 impose : les bibliotheques natives a venir (whisper.cpp, CTranslate2)
         n'existent pas en 32 bits. La configuration de la solution reste AnyCPU. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Babel.Core\Babel.Core.csproj" />
  </ItemGroup>

  <!-- Polices embarquees. Les fichiers sont absents du depot par defaut :
       voir assets/fonts/README.md. La condition evite de casser le build
       tant qu'ils n'ont pas ete deposes. -->
  <ItemGroup>
    <Resource Include="..\..\assets\fonts\*.ttf" Link="Fonts\%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\fonts\*.otf" Link="Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
