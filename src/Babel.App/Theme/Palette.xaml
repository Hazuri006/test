<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette de la section 5 de la specification. Ces six valeurs sont la
       reference : aucune couleur ne doit etre ecrite en dur ailleurs. -->
  <Color x:Key="PanelColor">#1E2422</Color>
  <Color x:Key="SurfaceColor">#2A312E</Color>
  <Color x:Key="RuleColor">#3E4844</Color>
  <Color x:Key="TextColor">#EDE8DC</Color>
  <Color x:Key="SignalColor">#E8A33D</Color>
  <Color x:Key="PausedColor">#C4483A</Color>

  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource RuleColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="SignalBrush" Color="{StaticResource SignalColor}" />
  <SolidColorBrush x:Key="PausedBrush" Color="{StaticResource PausedColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource TextColor}" Opacity="0.55" />

  <!-- Interface : humaniste a fort x-height. Les familles sont donnees en chaine
       de repli, pour que l'application reste correcte avant que les fichiers de
       police soient deposes (voir assets/fonts/README.md). -->
  <FontFamily x:Key="UiFontFamily">Source Sans 3, Source Sans Pro, Segoe UI, Tahoma</FontFamily>

  <!-- Monospace : reservee aux releves du HUD, nulle part ailleurs. -->
  <FontFamily x:Key="MonoFontFamily">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

  <!-- Sous-titres : lisibilite maximale, couverture CJK complete. -->
  <FontFamily x:Key="SubtitleFontFamily">Noto Sans, Noto Sans JP, Noto Sans KR, Noto Sans SC, Yu Gothic UI, Malgun Gothic, Microsoft YaHei, Segoe UI</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Hierarchie par filets et espacement : pas de carte, pas d'ombre, pas de degrade. -->
  <Style x:Key="Rule" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource RuleBrush}" />
    <Setter Property="Margin" Value="0,16,0,16" />
  </Style>

  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" Background="Transparent" Padding="18,11,18,11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Marker" Grid.Column="0" Background="Transparent" Margin="-18,-11,0,-11" />
              <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceBrush}" />
              <Setter TargetName="Marker" Property="Background" Value="{StaticResource SignalBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource RuleBrush}"
                  BorderThickness="1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SignalBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
    <Setter Property="Background" Value="{StaticResource RuleBrush}" />
    <Setter Property="Width" Value="360" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="IsSnapToTickEnabled" Value="False" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Width" Value="360" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

</ResourceDictionary>
