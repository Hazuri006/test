; Engine configuration file for BRICK CITY HERO.
; Godot 4.3+ project -- see README.md for the full file/system map.

config_version=5

[application]

config/name="Brick City Hero"
config/description="Open-world brick-city super hero action game. 100% original assets, procedurally generated."
config/version="1.0.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.06, 0.1, 1)
boot_splash/show_image=false

[autoload]

Events="*res://scripts/systems/event_bus.gd"
BrickKit="*res://scripts/systems/brick_kit.gd"
GameState="*res://scripts/systems/game_state.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
ObjectPool="*res://scripts/systems/object_pool.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
Transition="*res://scripts/systems/scene_transition.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

