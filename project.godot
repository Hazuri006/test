[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Monster"
3d_physics/layer_4="Interactable"
3d_physics/layer_5="Hideable"
3d_physics/layer_6="SoundArea"
3d_physics/layer_7="DynamicProp"
3d_physics/layer_8="VisionBlocker"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
global_illumination/gi/use_half_resolution=true
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=96
occlusion_culling/use_occlusion_culling=true

[file_customization]

folder_colors={
"res://assets/": "orange",
"res://autoload/": "red",
"res://data/": "green",
"res://scenes/": "blue",
"res://scripts/": "purple"
}
