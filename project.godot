; Engine configuration file.
; Projet : "Abyssal" — un survival sous-marin inspire de Subnautica
; Moteur cible : Godot 4.3 (Forward+)

config_version=5

[application]

config/name="Abyssal"
config/description="Survival sous-marin : ocean realiste, capsule de survie, fabricateur et exploration des fonds marins."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.05, 0.09, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://autoload/settings.gd"
ItemDB="*res://autoload/item_db.gd"
GameState="*res://autoload/game_state.gd"
SoundBank="*res://autoload/sound_bank.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
swim_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
swim_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
use_tool={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
alt_tool={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
flashlight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
slot_next={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
slot_prev={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
slot_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
slot_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
slot_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
slot_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
slot_5={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":53)]
}
toggle_quality={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194338)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="creature"
3d_physics/layer_5="vehicle"

[physics]

3d/default_gravity=9.81
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/ssil/quality=1
environment/screen_space_reflection/roughness_quality=2
environment/subsurface_scattering/subsurface_scattering_quality=2
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=192
environment/volumetric_fog/use_filter=1
environment/defaults/default_clear_color=Color(0.02, 0.07, 0.12, 1)
occlusion_culling/use_occlusion_culling=true
